//@version=6
indicator("MARK XAUUSD UZUN HEDEF", shorttitle="XAU UZUN", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200, max_bars_back=2000)

// ============================================================
// MARK XAUUSD UZUN HEDEF
// Amac: XAUUSD (altin) icin UZUN HEDEFLI AL/SAT sinyalleri.
// Kisa yerel (lokal) sinyaller FILTRELENIR - sadece buyuk hareket
// baslangicinda sinyal uretilir. Her sinyal uzun hedefe (TP2) ulasmayi
// hedefler. Repaint YOK (barstate.isconfirmed + lookahead_off).
// ============================================================

// ===== GIRISLER =====
gS = "Sinyal Motoru"
atrLen   = input.int(14,  "ATR periyodu",            5,    50,   group = gS)
sqMax    = input.float(2.5, "Sikisma esigi (range/ATR)", 0.1, 10.0, group = gS)
bodyMult = input.float(1.5, "Govde carpani (ATR)",    0.1,  5.0,  group = gS)
volMult  = input.float(1.5, "Hacim carpani (ort)",    0.1,  5.0,  group = gS)
minSweep = input.float(0.30, "Min sweep derinligi (ATR)", 0.05, 2.0, group = gS)
minBars  = input.int(20,   "Sinyaller arasi min bar",  5,   200,  group = gS)

gF = "Filtreler"
useMtf   = input.bool(true,  "4H trend filtresi (EMA200)",   group = gF)
useVol   = input.bool(true,  "Hacim onayi",                  group = gF)
useSq    = input.bool(true,  "Sikisma (compression) onayi", group = gF)
useDeep  = input.bool(true,  "Derin sweep onayi (bariz)",    group = gF)

gT = "Hedefler (ATR carpani)"
tp1Mult  = input.float(1.0, "TP1",  0.1, 10.0, group = gT)
tp2Mult  = input.float(2.0, "TP2 - UZUN HEDEF", 0.1, 10.0, group = gT)
slBuf    = input.float(0.25, "SL tamponu", 0.05, 2.0, group = gT)

gV = "Gorsel"
showBox  = input.bool(true, "Order block kutusu", group = gV)
showTp   = input.bool(true, "TP noktalari",       group = gV)
showLbl  = input.bool(true, "AL/SAT etiketi",     group = gV)

// ===== HESAPLAMALAR =====
atr = ta.atr(atrLen)

// 4H trend filtresi (repaint yok)
ema200_4h = request.security(syminfo.tickerid, "240", ta.ema(close, 200), lookahead = barmerge.lookahead_off)
trendBull = close > ema200_4h
trendBear = close < ema200_4h

// Hacim ortalamasi
volAvg   = ta.sma(volume, 20)
volSpike = volume > volAvg * volMult

// Sikisma: son 8 barda range / ATR
rangeN   = ta.highest(high, 8) - ta.lowest(low, 8)
sqRatio  = rangeN / atr
// son 8 bar icinde sikisma oldu mu
sqRecent = ta.lowest(sqRatio, 8) < sqMax

// Govde
bodySize = math.abs(close - open)
bigBody  = bodySize > atr * bodyMult

// Pivot (5/5) - onay 5 bar sonra gelir, lookahead yok
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)

// Son swing high/low takibi
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// Sweep derinligi
sweepLowDepth  = not na(lastPL) ? (lastPL - low) / atr  : 0.0
sweepHighDepth = not na(lastPH) ? (high - lastPH) / atr : 0.0

// ===== SINYAL KOSULLARI =====
sweepLow  = not na(lastPL) and low < lastPL - minSweep * atr and close > lastPL
sweepHigh = not na(lastPH) and high > lastPH + minSweep * atr and close < lastPH

deepOkBuy  = not useDeep or sweepLowDepth  >= minSweep
deepOkSell = not useDeep or sweepHighDepth >= minSweep

trendOkBuy  = not useMtf or trendBull
trendOkSell = not useMtf or trendBear

sqOk   = not useSq  or sqRecent
volOk  = not useVol or volSpike

buyCond  = sweepLow  and bigBody and trendOkBuy  and sqOk and volOk and deepOkBuy
sellCond = sweepHigh and bigBody and trendOkSell and sqOk and volOk and deepOkSell

// Sinyaller arasi min bar
var int lastSigBar = na
sigAllowed = na(lastSigBar) or (bar_index - lastSigBar) >= minBars
buySig  = buyCond  and sigAllowed and barstate.isconfirmed
sellSig = sellCond and sigAllowed and barstate.isconfirmed
if buySig or sellSig
    lastSigBar := bar_index

// ===== HEDEFLER =====
buySL   = low  - slBuf * atr
sellSL  = high + slBuf * atr
buyTP1  = close + tp1Mult * atr
buyTP2  = close + tp2Mult * atr   // UZUN HEDEF
sellTP1 = close - tp1Mult * atr
sellTP2 = close - tp2Mult * atr   // UZUN HEDEF

// ===== GORSEL =====
plotshape(buySig,  title="AL",  style=shape.circle, location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="AL")
plotshape(sellSig, title="SAT", style=shape.circle, location=location.abovebar, color=color.new(color.red,  0), size=size.small, text="SAT")

plot(showTp and buySig  ? buyTP2  : na, "Buy TP2 (uzun hedef)",  color=color.new(color.lime, 30), style=plot.style_circles, linewidth=2)
plot(showTp and sellSig ? sellTP2 : na, "Sell TP2 (uzun hedef)", color=color.new(color.red,   30), style=plot.style_circles, linewidth=2)

if showBox and buySig
    box.new(left=bar_index - 1, top=high, right=bar_index + 8, bottom=low, border_color=color.new(color.lime, 50), bgcolor=color.new(color.lime, 92))
if showBox and sellSig
    box.new(left=bar_index - 1, top=high, right=bar_index + 8, bottom=low, border_color=color.new(color.red,  50), bgcolor=color.new(color.red,  92))

if showLbl and buySig
    label.new(bar_index, low, "AL\nTP2: " + str.tostring(buyTP2, "#.##") + "\nSL: " + str.tostring(buySL, "#.##"), style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.white, size=size.small)
if showLbl and sellSig
    label.new(bar_index, high, "SAT\nTP2: " + str.tostring(sellTP2, "#.##") + "\nSL: " + str.tostring(sellSL, "#.##"), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

// ===== ALERT =====
alertcondition(buySig,  "XAU UZUN AL",  "XAUUSD UZUN HEDEF AL sinyali")
alertcondition(sellSig, "XAU UZUN SAT", "XAUUSD UZUN HEDEF SAT sinyali")
